{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaklab.dev/schemas/replay_bundle/1.1.json",
  "title": "LeakLab Replay Bundle v1.1",
  "description": "Schema v1.1. Two bundle kinds, told apart by kind: scenario_run (a benchmark replicate: v1.0 plus window, last_served, NOTHING_TO_REVOKE and caveats) and agent_trial (one S6 trial). v1.0 bundles stay valid against replay_bundle.schema.json; new exports are v1.1 only. The UI renders outcome, expected and verdict as given and never computes verdicts. All times are UNIX epoch seconds.",
  "oneOf": [
    {
      "$ref": "#/$defs/scenario_run"
    },
    {
      "$ref": "#/$defs/agent_trial"
    }
  ],
  "$defs": {
    "scenario_run": {
      "type": "object",
      "additionalProperties": false,
      "description": "One scenario replicate from one benchmark run: the v1.0 bundle plus window, last_served, NOTHING_TO_REVOKE and caveats.",
      "required": [
        "schema_version",
        "kind",
        "run",
        "scenario",
        "events",
        "summary",
        "caveats",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "kind": {
          "const": "scenario_run"
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "generation",
            "started_at",
            "read_interval_s",
            "poll_cap_s",
            "n_consecutive",
            "systems",
            "personas"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "description": "e.g. run_20261018T114324Z_r1"
            },
            "generation": {
              "type": "string",
              "description": "Tenant generation id, e.g. GTN3PY6"
            },
            "started_at": {
              "type": "number"
            },
            "read_interval_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "poll_cap_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "n_consecutive": {
              "type": "integer",
              "minimum": 1
            },
            "systems": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "config_label"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "setup0",
                      "setup_a_basic",
                      "setup_b"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "description": "Display name, e.g. 'SharePoint'"
                  },
                  "config_label": {
                    "type": "string",
                    "description": "Exact configuration caveat shown in the UI, e.g. 'Azure AI Search SharePoint indexer, basic ACL configuration, 5-min schedule'"
                  }
                }
              }
            },
            "personas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "display"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^p-"
                  },
                  "display": {
                    "type": "string",
                    "description": "Fictional display name from tenant_spec.yaml"
                  }
                }
              }
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description",
            "replicate",
            "baseline_target_s",
            "tracked_pairs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "e.g. S1-entra"
            },
            "description": {
              "type": "string"
            },
            "replicate": {
              "type": "integer",
              "minimum": 1
            },
            "baseline_target_s": {
              "type": "number",
              "minimum": 0
            },
            "tracked_pairs": {
              "type": "array",
              "description": "Every (persona, canary) pair that appears in events, with its role in the scenario.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "persona",
                  "canary",
                  "doc_label",
                  "role"
                ],
                "properties": {
                  "persona": {
                    "type": "string"
                  },
                  "canary": {
                    "type": "string",
                    "description": "Synthetic canary string (safe to publish)"
                  },
                  "doc_label": {
                    "type": "string",
                    "description": "Human label, e.g. 'S1-Entra/doc-01.txt' \u2014 no tenant URLs or item ids"
                  },
                  "role": {
                    "enum": [
                      "flipped",
                      "control",
                      "other"
                    ]
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "description": "Sorted by t ascending. Reads, indexer runs and poller lag are trimmed to the replay window (provenance.window_start .. window_end); phase and mutation events are never dropped. Discriminated by type.",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/read"
              },
              {
                "$ref": "#/$defs/mutation"
              },
              {
                "$ref": "#/$defs/indexer_run"
              },
              {
                "$ref": "#/$defs/phase"
              },
              {
                "$ref": "#/$defs/poller_lag"
              }
            ]
          }
        },
        "summary": {
          "type": "array",
          "description": "Copied from report.json for this replicate; computed on the FULL journal, not on the trimmed window. The exporter asserts equality with its own recomputation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "status",
              "first_deny_s",
              "leak_exposure_s",
              "time_to_conformance_s",
              "n_reads",
              "n_errors",
              "lockouts"
            ],
            "properties": {
              "system": {
                "enum": [
                  "setup0",
                  "setup_a_basic",
                  "setup_b"
                ]
              },
              "status": {
                "enum": [
                  "CONVERGED",
                  "DID_NOT_CONVERGE",
                  "INSUFFICIENT_DATA",
                  "NOT_APPLICABLE",
                  "NOTHING_TO_REVOKE"
                ],
                "description": "NOTHING_TO_REVOKE (v1.1): the system never served the flipped pair before the change, so there was nothing to revoke. It is not NOT_APPLICABLE and is never drawn red or green."
              },
              "first_deny_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "leak_exposure_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "time_to_conformance_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "n_reads": {
                "type": "integer",
                "minimum": 0
              },
              "n_errors": {
                "type": "integer",
                "minimum": 0
              },
              "lockouts": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "v1.1: caveats the UI must show, generated by the exporter from run and report metadata."
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journal_file",
            "report_file",
            "exporter_version",
            "git_commit",
            "exported_at",
            "window_start",
            "window_end",
            "reads_dropped"
          ],
          "properties": {
            "journal_file": {
              "type": "string"
            },
            "report_file": {
              "type": "string"
            },
            "exporter_version": {
              "type": "string"
            },
            "git_commit": {
              "type": "string"
            },
            "exported_at": {
              "type": "number"
            },
            "window_start": {
              "type": "number",
              "description": "Epoch seconds: the first replayed instant (baseline start)."
            },
            "window_end": {
              "type": "number",
              "description": "Epoch seconds: the later of the last served read of a flipped pair and the conformance time, plus 60 s, capped at the poll cap."
            },
            "reads_dropped": {
              "type": "integer",
              "minimum": 0,
              "description": "Reads of the tracked pairs outside the window; they are not in events."
            }
          }
        }
      }
    },
    "agent_trial": {
      "type": "object",
      "additionalProperties": false,
      "description": "One S6 trial: one agent arm answering the designed sequence of questions.",
      "required": [
        "schema_version",
        "kind",
        "run",
        "trial",
        "turns",
        "mutations",
        "validity",
        "summary",
        "caveats",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "kind": {
          "const": "agent_trial"
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "generation",
            "started_at",
            "llm",
            "embedder",
            "cache_threshold",
            "memory_threshold",
            "personas"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "started_at": {
              "type": "number"
            },
            "llm": {
              "type": "string"
            },
            "embedder": {
              "type": "string"
            },
            "cache_threshold": {
              "type": "number"
            },
            "memory_threshold": {
              "type": "number"
            },
            "personas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "display"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^p-"
                  },
                  "display": {
                    "type": "string",
                    "description": "Fictional display name from tenant_spec.yaml"
                  }
                }
              }
            }
          }
        },
        "trial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario",
            "kind",
            "arm",
            "n",
            "trial",
            "question_source"
          ],
          "properties": {
            "scenario": {
              "enum": [
                "S6a",
                "S6b",
                "S6c",
                "positive_control"
              ]
            },
            "kind": {
              "enum": [
                "cross_user_cache",
                "cache_after_revocation",
                "shared_memory",
                "positive_control"
              ]
            },
            "arm": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "mode"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "agent_naive_a",
                    "agent_naive_b",
                    "agent_guarded_b"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "naive",
                    "guarded"
                  ]
                }
              }
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "description": "Trials of this scenario and arm in the run."
            },
            "trial": {
              "type": "integer",
              "minimum": 1
            },
            "question_source": {
              "type": "string",
              "description": "Label of the document the seed question is about."
            }
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t",
              "t_rel_s",
              "step",
              "persona",
              "query",
              "path",
              "similarity",
              "source_doc_labels",
              "delivered_canaries",
              "verdict",
              "guard_decision",
              "guard_reason"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "t_rel_s": {
                "type": "number",
                "description": "Seconds since the first turn of the trial."
              },
              "step": {
                "enum": [
                  "seed",
                  "followup"
                ],
                "description": "seed = the earlier user's question; followup = the question that tries to reuse it."
              },
              "persona": {
                "type": "string",
                "pattern": "^p-"
              },
              "query": {
                "type": "string"
              },
              "path": {
                "enum": [
                  "cache_hit",
                  "memory_hit",
                  "retrieval"
                ]
              },
              "similarity": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Cache similarity (hit or candidate), else the best memory similarity, else null."
              },
              "source_doc_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Documents whose canaries appear in the delivered answer."
              },
              "delivered_canaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "canary",
                    "doc_label",
                    "expected",
                    "verdict"
                  ],
                  "properties": {
                    "canary": {
                      "type": "string"
                    },
                    "doc_label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expected": {
                      "enum": [
                        "allow",
                        "deny"
                      ],
                      "description": "The oracle's intent for this persona and canary when the answer was delivered."
                    },
                    "verdict": {
                      "enum": [
                        "ok",
                        "leak"
                      ]
                    }
                  }
                }
              },
              "verdict": {
                "enum": [
                  "ok",
                  "leak",
                  "unscored"
                ],
                "description": "leak if any delivered canary is not allowed; unscored if the step produced no answer."
              },
              "guard_decision": {
                "enum": [
                  "allowed",
                  "denied",
                  "n/a"
                ]
              },
              "guard_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t",
              "t_rel_s",
              "summary"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "t_rel_s": {
                "type": "number"
              },
              "summary": {
                "type": "string"
              }
            }
          }
        },
        "validity": {
          "enum": [
            "VALID",
            "INVALID"
          ],
          "description": "INVALID: the designed situation did not happen; the trial says nothing and is never counted as OK."
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "description": "Copied from the S6 report row for this trial; the exporter asserts it equals its own scoring of the journal.",
          "required": [
            "verdict",
            "reason",
            "similarity",
            "cache_status",
            "delivered",
            "leaks",
            "guard_denials",
            "exposure_stored",
            "exposure_unsafe",
            "exposure_pairs"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "LEAK",
                "OK",
                "INVALID",
                "SERVED",
                "OVERBLOCK"
              ]
            },
            "reason": {
              "type": "string"
            },
            "similarity": {
              "type": [
                "number",
                "null"
              ]
            },
            "cache_status": {
              "type": "string"
            },
            "delivered": {
              "type": "integer",
              "minimum": 0
            },
            "leaks": {
              "type": "integer",
              "minimum": 0
            },
            "guard_denials": {
              "type": "integer",
              "minimum": 0
            },
            "exposure_stored": {
              "type": "integer",
              "minimum": 0
            },
            "exposure_unsafe": {
              "type": "integer",
              "minimum": 0
            },
            "exposure_pairs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "v1.1: caveats the UI must show, generated by the exporter from run and report metadata."
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journal_file",
            "report_file",
            "exporter_version",
            "git_commit",
            "exported_at"
          ],
          "properties": {
            "journal_file": {
              "type": "string"
            },
            "report_file": {
              "type": "string"
            },
            "exporter_version": {
              "type": "string"
            },
            "git_commit": {
              "type": "string"
            },
            "exported_at": {
              "type": "number"
            }
          }
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t",
        "t_rel_s",
        "phase",
        "system",
        "persona",
        "canary",
        "outcome",
        "expected",
        "verdict"
      ],
      "properties": {
        "type": {
          "const": "read"
        },
        "t": {
          "type": "number"
        },
        "t_rel_s": {
          "type": "number"
        },
        "phase": {
          "enum": [
            "baseline",
            "poll"
          ]
        },
        "system": {
          "enum": [
            "setup0",
            "setup_a_basic",
            "setup_b"
          ]
        },
        "persona": {
          "type": "string"
        },
        "canary": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "served",
            "denied",
            "error",
            "not_indexed"
          ],
          "description": "error and not_indexed are NEVER rendered as denied."
        },
        "status_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "error_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected": {
          "enum": [
            "allow",
            "deny"
          ],
          "description": "Oracle's intent for this (persona, canary) at time t, computed by the exporter via IntentTimeline."
        },
        "verdict": {
          "enum": [
            "ok",
            "leak",
            "lockout",
            "unscored"
          ],
          "description": "leak = served while expected deny; lockout = denied while expected allow; unscored = error/not_indexed."
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t",
        "t_rel_s",
        "t_requested",
        "t_confirmed",
        "mutation_type",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "mutation"
        },
        "t": {
          "type": "number",
          "description": "= t_confirmed"
        },
        "t_rel_s": {
          "type": "number",
          "description": "0 for the scenario's mutation"
        },
        "t_requested": {
          "type": "number"
        },
        "t_confirmed": {
          "type": "number"
        },
        "mutation_type": {
          "type": "string",
          "description": "e.g. group_member_removed"
        },
        "summary": {
          "type": "string",
          "description": "Human text, e.g. 'p-plateng removed from ll-grp-s1-entra'"
        }
      }
    },
    "indexer_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t",
        "t_rel_s",
        "system",
        "index",
        "t_start",
        "t_end",
        "status"
      ],
      "properties": {
        "type": {
          "const": "indexer_run"
        },
        "t": {
          "type": "number",
          "description": "= t_start"
        },
        "t_rel_s": {
          "type": "number"
        },
        "system": {
          "enum": [
            "setup_a_basic",
            "setup_b"
          ]
        },
        "index": {
          "type": "string"
        },
        "t_start": {
          "type": "number"
        },
        "t_end": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "description": "A status from the indexer, or unfinished_at_journal_end (v1.1) when the journal ends before the run is reported finished; t_end is then null."
        },
        "items_processed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t",
        "t_rel_s",
        "name"
      ],
      "properties": {
        "type": {
          "const": "phase"
        },
        "t": {
          "type": "number"
        },
        "t_rel_s": {
          "type": "number"
        },
        "name": {
          "enum": [
            "ready",
            "baseline_start",
            "baseline_stable",
            "poll_start",
            "first_deny",
            "last_served",
            "converged",
            "cap_reached"
          ],
          "description": "v1.1 adds last_served: the last served read of a flipped pair after t=0, per system."
        },
        "system": {
          "enum": [
            "setup0",
            "setup_a_basic",
            "setup_b",
            null
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "poller_lag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t",
        "t_rel_s",
        "poller",
        "lag_s"
      ],
      "properties": {
        "type": {
          "const": "poller_lag"
        },
        "t": {
          "type": "number"
        },
        "t_rel_s": {
          "type": "number"
        },
        "poller": {
          "enum": [
            "membership",
            "acl"
          ]
        },
        "lag_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}