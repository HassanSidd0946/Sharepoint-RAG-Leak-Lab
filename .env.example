# Copy to .env and fill in. Never commit .env.
# Safety guard: scripts that write to a tenant abort unless the token's tenant ID
# matches LEAKLAB_ALLOWED_TENANT_ID.
LEAKLAB_TENANT_ID=
LEAKLAB_ALLOWED_TENANT_ID=

# Driver app (certificate-based app-only auth)
LEAKLAB_DRIVER_CLIENT_ID=
LEAKLAB_CERT_PATH=
LEAKLAB_CERT_PUBLIC_PATH=
LEAKLAB_CERT_THUMBPRINT=

# Persona app + shared persona password (test tenant only)
LEAKLAB_PERSONA_CLIENT_ID=
LEAKLAB_PERSONA_PASSWORD=

# SharePoint
LEAKLAB_SITE_URL=
LEAKLAB_SP_HOST=
