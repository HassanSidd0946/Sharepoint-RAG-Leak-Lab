# Copy to .env and fill in. Never commit .env.
# Safety guard: scripts that write to a tenant abort unless the token's tenant ID
# matches LEAKLAB_ALLOWED_TENANT_ID.
LEAKLAB_TENANT_ID=
LEAKLAB_ALLOWED_TENANT_ID=

# Driver app (certificate-based app-only auth)
LEAKLAB_DRIVER_CLIENT_ID=
LEAKLAB_CERT_PATH=
LEAKLAB_CERT_PUBLIC_PATH=
LEAKLAB_CERT_THUMBPRINT=

# Persona app + shared persona password (test tenant only)
LEAKLAB_PERSONA_CLIENT_ID=
LEAKLAB_PERSONA_PASSWORD=

# SharePoint
LEAKLAB_SITE_URL=
LEAKLAB_SP_HOST=

# Country code for synthetic users (required to assign licenses), e.g. US
LEAKLAB_USAGE_LOCATION=

# UPN of your own admin account (used by access_probe via device code; no password here)
LEAKLAB_ADMIN_UPN=

# Setup A: Azure AI Search (probes/search_provision.py prints the endpoint and saves it to runs/)
LEAKLAB_SEARCH_ENDPOINT=
# The Entra app the SharePoint indexer signs in as (Graph application permissions Files.Read.All and
# Sites.FullControl.All, admin consent granted) and its client secret. Never commit the secret.
LEAKLAB_INGEST_APP_ID=
LEAKLAB_INGEST_APP_SECRET=
